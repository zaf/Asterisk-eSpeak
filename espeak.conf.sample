;
; eSpeak Configuration
;
[general]
;
; Use cache (yes, no - defaults to no)
;
;usecache=yes
;
; If usecache=yes, a directory to store waveform cache files. 
; The cache is never cleared by the application, so you must take care of
; cleaning it yourself (just delete any or all files from the cache).
; The directory is created (mode 0700) if missing. It MUST be owned by the
; asterisk user and MUST NOT be group or world writable, otherwise caching
; is disabled (a shared directory would allow other local users to inject
; audio into your calls). Cached prompts are stored on disk unencrypted;
; avoid caching if your prompts contain sensitive data.
; Defaults to /var/lib/asterisk/espeakcache
;
;cachedir=/var/lib/asterisk/espeakcache
;
; Target sample rate for the generated sound files in Hz (default is 8000)
; For now app_espeak supports generation of 8000Hz or 16000Hz sound files
; so possible values are only 8000 and 16000. If set to another value it will 
; automatically fall back to 8000Hz.
;
;samplerate=8000
;
; Maximum length of the text argument in bytes, 1 to 32768.
; Longer requests are rejected. (default is 4096)
;
;maxtext=4096
;

[voice]
;
; The voice to use, i.e.
; the name of the voice file to use from from espeak-data/voices
; Use "espeak --voices" for a list of available voices
; MBROLA voices can also be used if they are available (eg "mb-us1")
; (default is "en-us")
;
;voice=af
;
; The playback speed in words per minute, 80 to 450 (default is 150)
;
;speed=130
;
;  Amplitude, 0 to 200, default is 100
;
;volume=100
;
; Word gap. Pause between words, units of 10mS at the default speed,
; 0 to 1000 (default is 1)
;
;wordgap=1
;
; Pitch adjustment, 0 to 99, default is 50
;
;pitch=40
